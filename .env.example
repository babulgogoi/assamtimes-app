PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assamtimes_db
DB_USER=assamtimes_user
DB_PASSWORD=changeme

# Site
SITE_URL=http://localhost:3000
SITE_FACEBOOK_URL=https://www.facebook.com/yourpage/

# Google Analytics 4 (leave unset to disable tracking entirely)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare (cache purge only — token scoped to Zone.Cache Purge)
CF_API_TOKEN=changeme
CF_ZONE_ID=changeme

# Session (generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=changeme

# Web Push (VAPID) — generate your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Uploads (absolute paths on this host, served from public_html outside the app dir)
UPLOADS_ARTICLES_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/articles
UPLOADS_AUDIO_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/audio
UPLOADS_DOCUMENTS_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/documents
UPLOADS_DEFAULTS_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/defaults
UPLOADS_BRANDING_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/branding
UPLOADS_AUTHORS_DIR=/home/assam1/web/new.assamtimes.org/public_html/uploads/authors

# AdSense (replace with real values from your AdSense dashboard)
ADSENSE_ENABLED=true
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_SLOT_HEADER=0000000001
ADSENSE_SLOT_SIDEBAR=0000000002
ADSENSE_SLOT_IN_ARTICLE=0000000003

# SendPulse (newsletter sync) — not yet set up; leave unset to skip syncing
# new signups and just keep them in the local newsletter_subscribers table.
SENDPULSE_API_USER_ID=changeme
SENDPULSE_API_SECRET=changeme
SENDPULSE_ADDRESSBOOK_ID=changeme

# D7 re-engagement newsletter (scripts 030 send / 031 bounce handler).
# SMTP defaults to the local exim relay on localhost:25 (no auth).
SMTP_HOST=localhost
SMTP_PORT=25
NEWSLETTER_FROM=Assam Times Newsletter <no-reply@newsletter.assamtimes.org>
NEWSLETTER_REPLY_TO=bounce@newsletter.assamtimes.org
# Bounce mailbox (IMAP) — password is set in HestiaCP for the mailbox below.
# 031_process_bounces.js skips (no-op) until BOUNCE_MAIL_PASSWORD is set.
BOUNCE_MAIL_USER=bounce@newsletter.assamtimes.org
BOUNCE_MAIL_PASSWORD=changeme
IMAP_HOST=localhost
IMAP_PORT=993

# Facebook auto-post on article publish
FACEBOOK_PAGE_ACCESS_TOKEN=changeme
FACEBOOK_PAGE_ID=changeme

# hCaptcha (comment form spam protection)
HCAPTCHA_SITE_KEY=changeme
HCAPTCHA_SECRET_KEY=changeme

# Twitter/X auto-post on article publish (leave TWITTER_ENABLED=false with no API credits)
TWITTER_ENABLED=false
TWITTER_API_KEY=changeme
TWITTER_API_SECRET=changeme
TWITTER_ACCESS_TOKEN=changeme
TWITTER_ACCESS_TOKEN_SECRET=changeme

# PDF download (puppeteer-core). Leave unset to use the system chromium-browser
# at /usr/bin/chromium-browser (src/utils/pdfBrowser.js's fallback) — NOTE: on
# Ubuntu 24.04 that path is a broken snap-wrapper script (fails under PM2's
# non-interactive session, see CLAUDE.md). Set this to a real Chrome binary
# instead, e.g. one installed via `npx @puppeteer/browsers install chrome@stable`.
CHROMIUM_PATH=changeme

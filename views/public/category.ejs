<div class="home-layout">
  <div class="home-main">
    <h1 class="page-title"><%= category %></h1>

    <% if (!articles.length) { %>
      <p>No articles found in this category.</p>
    <% } else { %>
      <div class="article-grid">
        <% articles.forEach(function (article, articleIndex) { %>
          <article class="story-card story-card--medium">
            <a class="story-card__link" href="/article/<%= article.slug %>">
              <div class="story-card__media">
                <img class="story-card__image" src="<%= article.featured_image || '/uploads/defaults/at-news.png' %>" alt="<%= article.title %>"<%- articleIndex === 0 ? ' loading="eager"' : ' loading="lazy"' %>>
                <% if (article.category) { %>
                  <span class="story-card__tag"><%= article.category %></span>
                <% } %>
              </div>
              <h2 class="story-card__title">
                <% if (article.is_liveblog) { %><span class="liveblog-badge<%= article.liveblog_status === 'live' ? ' is-live' : '' %>"><%= article.liveblog_status === 'live' ? '&#128308; LIVE' : 'LIVE BLOG' %></span><% } %>
                <%= article.title %>
              </h2>
            </a>
            <p class="story-card__meta">
              <% if (article.author_username) { %>
                <a href="/author/<%= encodeURIComponent(article.author_username) %>"><%= article.author_name %></a> &middot;
              <% } %>
              <%= article.published_at ? new Date(article.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : '' %>
            </p>
          </article>
        <% }) %>
      </div>

      <nav class="pagination">
        <% if (page > 1) { %>
          <a href="/category/<%= encodeURIComponent(category) %>?page=<%= page - 1 %>">&laquo; Prev</a>
        <% } %>
        <span>Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/category/<%= encodeURIComponent(category) %>?page=<%= page + 1 %>">Next &raquo;</a>
        <% } %>
      </nav>
    <% } %>
  </div>

  <aside class="home-sidebar divider-v">
    <%- include('../partials/sidebar-news-category') %>
  </aside>
</div>

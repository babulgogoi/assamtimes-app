<%
  // Set by publicController.articleInline for a fragment injected via
  // infinite-scroll.js — '' for a normal full page load. Appended to every
  // hardcoded id in this template (+ article-body-extras.ejs/
  // article-comments.ejs) so a swapped-in article's markup never collides
  // with the original page's ids in the DOM. See public/js/article.js's
  // AT.initArticleInstance(suffix) for the matching client-side half.
  var domSuffix = typeof domSuffix !== 'undefined' ? domSuffix : '';
  var isInline = typeof isInline !== 'undefined' && isInline;
%>
<% if (sectionDesigns.article === 'B') { %>

<article class="article-b" data-article-slug="<%= article.slug %>" data-instance-suffix="<%= domSuffix %>">
  <div class="article-b-col">
    <% if (typeof isPreview !== 'undefined' && isPreview) { %>
      <div class="preview-banner" role="alert">
        &#128065; Preview only — this article is
        <strong><%= article.status === 'scheduled' ? 'scheduled, not yet published' : 'a draft, not yet published' %></strong>.
        Only you can see this page.
      </div>
    <% } %>

    <h1><%= article.title %></h1>
    <div class="infinite-scroll-active-marker" data-suffix="<%= domSuffix %>" aria-hidden="true"></div>

    <div class="article-b-toolbar">
      <a href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + canonicalUrl) %>" class="article-b-share-icon" target="_blank" rel="noopener" aria-label="Share this article on WhatsApp" title="Share on WhatsApp">
        <%- include('../partials/icons/whatsapp') %>
      </a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" class="article-b-share-icon" target="_blank" rel="noopener" aria-label="Share this article on Facebook" title="Share on Facebook">
        <%- include('../partials/icons/facebook') %>
      </a>
      <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(canonicalUrl) %>&text=<%= encodeURIComponent(article.title) %>" class="article-b-share-icon" target="_blank" rel="noopener" aria-label="Share this article on X (Twitter)" title="Share on X">
        <%- include('../partials/icons/x') %>
      </a>
      <button class="copy-link-btn js-copy-link" type="button" aria-label="Copy article link to clipboard" title="Copy link" data-copied-message="Link copied!" data-url="<%= canonicalUrl %>">
        <%- include('../partials/icons/copy') %>
      </button>
      <a href="/article/<%= article.slug %>/pdf" class="article-b-share-icon" target="_blank" aria-label="Print this article (downloads a PDF)" title="Print (PDF)">
        <%- include('../partials/icons/print') %>
      </a>
      <a href="mailto:?subject=<%= encodeURIComponent(article.title) %>&body=<%= encodeURIComponent(canonicalUrl) %>" class="article-b-share-icon" aria-label="Share this article by email" title="Share by email">
        <%- include('../partials/icons/email') %>
      </a>
      <span class="toolbar-spacer"></span>
      <a href="#comments<%= domSuffix %>" class="comments-btn" aria-label="View comments" title="View comments">
        <%- include('../partials/icons/comment') %> Comments <%= commentsCount %>
      </a>
    </div>

    <% if (article.featured_image) { %>
      <figure class="article-b-image">
        <img src="<%= articleImageUrl(article.featured_image) %>" alt="<%= article.featured_image_alt || article.featured_image_caption || article.title %>" width="700" height="400" loading="eager">
        <% if (article.featured_image_caption) { %>
          <figcaption><%= article.featured_image_caption %></figcaption>
        <% } %>
      </figure>
    <% } %>

    <% if (article.author_username || article.published_at) { %>
      <div class="article-b-meta">
        <% if (article.author_username) { %>
          <img class="meta-avatar" src="<%= article.author_photo || '/uploads/defaults/avatar.png' %>" alt="">
          <a href="/author/<%= encodeURIComponent(article.author_username) %>" class="meta-author"><%= article.author_name %></a>
        <% } %>
        <% if (article.published_at) { %>
          <span class="meta-date"><%= new Date(article.published_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        <% } %>
        <% if (article.updated_at && article.published_at && (new Date(article.updated_at) - new Date(article.published_at)) > 5 * 60 * 1000) { %>
          <span class="meta-updated">Updated <%= new Date(article.updated_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
        <% } %>
        <span class="meta-views"><%= article.views_count %> views</span>
      </div>
    <% } %>

    <div class="article-b-body">
      <%- bodyWithDateline || article.body %>
    </div>

    <%- include('../partials/article-body-extras') %>

    <%- include('../partials/infinite-scroll-seed') %>

    <% if (article.author_username) { %>
      <div class="article-b-author-box">
        <a href="/author/<%= encodeURIComponent(article.author_username) %>"><%= article.author_name %></a>
        <p><%= article.author_bio || '' %></p>
      </div>
    <% } %>

    <%# Comments (form + list) live here — inside the 620px column, right
        below the author box — rather than after .article-b-related below.
        article-comments.ejs mixes the form and the existing-comments list
        in one partial with no natural split point, so the whole thing
        moves together; #comments (the toolbar's jump-link target) stays
        on the partial's own <section>, just relocated earlier in the DOM. %>
    <div class="article-b-comments">
      <%- include('../partials/article-comments') %>
    </div>
  </div>

  <% if ((authorArticles && authorArticles.length) || (typeof onThisDayArticles !== 'undefined' && onThisDayArticles.length) || (related && related.length)) { %>
    <div class="article-b-related">
      <% if (authorArticles && authorArticles.length) { %>
        <div class="related-col">
          <h3>By <%= article.author_name %></h3>
          <% authorArticles.forEach(function (a) { %>
            <a href="/article/<%= a.slug %>"><%= a.title %></a>
          <% }); %>
        </div>
      <% } %>
      <% if (typeof onThisDayArticles !== 'undefined' && onThisDayArticles.length) { %>
        <div class="related-col">
          <h3>On This Day</h3>
          <% onThisDayArticles.forEach(function (a) { %>
            <a href="/article/<%= a.slug %>"><%= a.title %></a>
          <% }); %>
        </div>
      <% } %>
      <% if (related && related.length) { %>
        <div class="related-col">
          <h3>Related</h3>
          <% related.forEach(function (a) { %>
            <a href="/article/<%= a.slug %>"><%= a.title %></a>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>
</article>

<% if (!isInline) { %>
<script src="/js/<%= process.env.NODE_ENV === 'production' ? 'article.min.js?v=2' : 'article.js' %>" defer></script>
<script src="/js/<%= process.env.NODE_ENV === 'production' ? 'infinite-scroll.min.js' : 'infinite-scroll.js' %>" defer></script>
<% if (article.is_liveblog && article.liveblog_status === 'live') { %>
  <script src="/js/<%= process.env.NODE_ENV === 'production' ? 'liveblog.min.js' : 'liveblog.js' %>" defer></script>
<% } %>
<% } %>

<% } else { %>

<div class="home-layout" data-article-slug="<%= article.slug %>" data-instance-suffix="<%= domSuffix %>">
  <div class="home-main">
    <article class="article-detail">
      <div class="print-header">
        <div class="print-header__site">Assam Times</div>
        <div class="print-header__url">assamtimes.org</div>
      </div>

      <div class="sticky-share" aria-label="Share this article">
        <a class="share-icon share-icon--whatsapp" href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on WhatsApp" title="Share on WhatsApp">
          <%- include('../partials/icons/whatsapp') %>
        </a>
        <a class="share-icon share-icon--facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on Facebook" title="Share on Facebook">
          <%- include('../partials/icons/facebook') %>
        </a>
        <a class="share-icon share-icon--x" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(canonicalUrl) %>&text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" aria-label="Share this article on X (Twitter)" title="Share on X">
          <%- include('../partials/icons/x') %>
        </a>
        <button class="share-icon share-icon--copy js-copy-link" type="button" aria-label="Copy article link to clipboard" title="Copy link" data-copied-message="Link copied!" data-url="<%= canonicalUrl %>">
          <%- include('../partials/icons/copy') %>
        </button>
      </div>

      <% if (typeof isPreview !== 'undefined' && isPreview) { %>
        <div class="preview-banner" role="alert">
          &#128065; Preview only — this article is
          <strong><%= article.status === 'scheduled' ? 'scheduled, not yet published' : 'a draft, not yet published' %></strong>.
          Only you can see this page.
        </div>
      <% } %>

      <header>
      <% if (article.category) { %>
        <a href="/category/<%= encodeURIComponent(article.category) %>" class="article-category"><%= article.category %></a>
      <% } %>

      <div class="article-utility-bar">
        <button class="util-btn" id="btnPrint<%= domSuffix %>" title="Print article" aria-label="Print article">
          &#128424; <span class="util-label">Print</span>
        </button>
        <a class="util-btn" href="/article/<%= article.slug %>/pdf" title="Download as PDF" aria-label="Download article as PDF" target="_blank">
          &#128196; <span class="util-label">PDF</span>
        </a>
        <div class="util-divider"></div>
        <button class="util-btn" id="btnFontDown<%= domSuffix %>" aria-label="Decrease text size">A-</button>
        <button class="util-btn util-font-mid" id="btnFontReset<%= domSuffix %>" aria-label="Default text size">A</button>
        <button class="util-btn" id="btnFontUp<%= domSuffix %>" aria-label="Increase text size">A+</button>
        <div class="util-divider"></div>
        <button class="util-btn" id="btnDarkMode<%= domSuffix %>" aria-label="Toggle dark mode">&#127769;</button>
        <div class="util-divider"></div>
        <button class="util-btn" id="btnHighContrast<%= domSuffix %>" aria-label="Toggle high contrast mode" title="High contrast mode">HC</button>
      </div>

      <h1 class="article-detail__title"><%= article.title %></h1>
      <div class="infinite-scroll-active-marker" data-suffix="<%= domSuffix %>" aria-hidden="true"></div>

      <% if (article.subheadline) { %>
        <p class="article-detail__subheadline"><%= article.subheadline %></p>
      <% } %>

      <div class="share-row share-row--top">
        <div class="share-row__icons">
          <a class="share-icon share-icon--sm share-icon--whatsapp" href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on WhatsApp" title="Share on WhatsApp">
            <%- include('../partials/icons/whatsapp') %>
          </a>
          <a class="share-icon share-icon--sm share-icon--facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on Facebook" title="Share on Facebook">
            <%- include('../partials/icons/facebook') %>
          </a>
          <a class="share-icon share-icon--sm share-icon--x" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(canonicalUrl) %>&text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" aria-label="Share this article on X (Twitter)" title="Share on X">
            <%- include('../partials/icons/x') %>
          </a>
          <button class="share-icon share-icon--sm share-icon--copy js-copy-link" type="button" aria-label="Copy article link to clipboard" title="Copy link" data-copied-message="Link copied!" data-url="<%= canonicalUrl %>">
            <%- include('../partials/icons/copy') %>
          </button>
        </div>

        <a class="comments-jump" href="#comments<%= domSuffix %>" aria-label="View comments" title="View comments">
          <%- include('../partials/icons/comment') %>
          <span>Comments <%= commentsCount %></span>
        </a>
      </div>

      <%
        function formatArticleDateTime(d) {
          var date = new Date(d);
          var time = date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
          var day = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
          return time + ', ' + day;
        }
        var showUpdated = !!(
          article.published_at &&
          article.updated_at &&
          (new Date(article.updated_at) - new Date(article.published_at)) > 5 * 60 * 1000
        );
      %>
      <% if (article.author_username || article.published_at) { %>
        <div class="article-byline">
          <% if (article.author_username) { %>
            <img class="article-meta__photo" src="<%= article.author_photo || '/uploads/defaults/avatar.png' %>" alt="<%= (article.author_name || article.author_username) %>, journalist at Assam Times">
          <% } %>
          <p class="article-meta">
            <% if (article.author_username) { %>
              <a href="/author/<%= encodeURIComponent(article.author_username) %>" class="byline-primary-author"><%= article.author_name %></a>
              <% (coauthors || []).forEach(function (ca) { %>
                <span class="byline-separator">&amp;</span>
                <a href="/author/<%= encodeURIComponent(ca.username) %>" class="byline-coauthor"><%= ca.display_name || ca.username %><span class="byline-role">(<%= ca.role %>)</span></a>
              <% }) %>
              &middot;
            <% } %>
            <% if (article.published_at) { %>
              <%= formatArticleDateTime(article.published_at) %><% if (showUpdated) { %> | Updated <%= formatArticleDateTime(article.updated_at) %><% } %> &middot;
            <% } %>
            <span class="article-meta__views"><%= article.views_count %> views</span> &middot; <%= readingTime %> min read
          </p>
        </div>
      <% } %>
      </header>

      <figure class="article-featured">
        <img class="article-detail__image" src="<%= articleImageUrl(article.featured_image) %>" width="630" height="420" alt="<%= article.featured_image_alt || article.featured_image_caption || article.title %>">
        <% if (article.featured_image_caption) { %>
          <figcaption><%= article.featured_image_caption %></figcaption>
        <% } %>
      </figure>

      <% if (article.excerpt) { %>
        <p class="article-detail__excerpt"><%= article.excerpt %></p>
      <% } %>

      <div class="article-detail__body">
        <%- bodyWithDateline || article.body %>
      </div>

      <%- include('../partials/article-body-extras') %>

      <%- include('../partials/infinite-scroll-seed') %>

      <div class="article-actions">
        <button class="like-btn" id="likeBtn<%= domSuffix %>" type="button" data-slug="<%= article.slug %>" aria-label="Like this article" title="Like this article">
          <svg class="like-btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 21s-6.7-4.35-9.3-8.1C.7 9.7 1.7 6 5 4.7c2-0.8 4 0 5 1.6 1-1.6 3-2.4 5-1.6 3.3 1.3 4.3 5 2.3 8.2C18.7 16.65 12 21 12 21z"/>
          </svg>
          <span class="like-btn__count"><%= article.likes_count || 0 %></span>
        </button>

        <div class="share-links share-links--full">
          <span class="share-links__label">Share this article:</span>

          <a class="share-pill share-pill--whatsapp" href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on WhatsApp" title="Share on WhatsApp">
            <%- include('../partials/icons/whatsapp') %><span>WhatsApp</span>
          </a>

          <a class="share-pill share-pill--facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on Facebook" title="Share on Facebook">
            <%- include('../partials/icons/facebook') %><span>Facebook</span>
          </a>

          <a class="share-pill share-pill--x" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(canonicalUrl) %>&text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" aria-label="Share this article on X (Twitter)" title="Share on X">
            <%- include('../partials/icons/x') %><span>X</span>
          </a>

          <a class="share-pill share-pill--linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(canonicalUrl) %>" target="_blank" rel="noopener" aria-label="Share this article on LinkedIn" title="Share on LinkedIn">
            <%- include('../partials/icons/linkedin') %><span>LinkedIn</span>
          </a>

          <button class="share-pill share-pill--copy js-copy-link" type="button" aria-label="Copy article link to clipboard" title="Copy link" data-copied-message="Link copied!" data-url="<%= canonicalUrl %>">
            <%- include('../partials/icons/copy') %><span>Copy link</span>
          </button>

          <a class="share-pill share-pill--email" href="mailto:?subject=<%= encodeURIComponent(article.title) %>&body=<%= encodeURIComponent(canonicalUrl) %>" aria-label="Share this article by email" title="Share by email">
            <%- include('../partials/icons/email') %><span>Email</span>
          </a>
        </div>
      </div>

      <% if (article.author_username) { %>
        <div class="author-box">
          <img class="author-box__photo" src="<%= article.author_photo || '/uploads/defaults/avatar.png' %>" alt="<%= (article.author_name || article.author_username) %>, journalist at Assam Times">
          <div class="author-box__info">
            <h3 class="author-box__name"><a href="/author/<%= encodeURIComponent(article.author_username) %>"><%= article.author_name %></a></h3>
            <% if (article.author_bio) { %>
              <p class="author-box__bio"><%= article.author_bio %></p>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="print-footer">
        Original URL: <%= process.env.SITE_URL %>/article/<%= article.slug %> |
        Published: <%= article.published_at ? new Date(article.published_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %> |
        &copy; <%= new Date().getFullYear() %> Assam Times
      </div>

      <%- include('../partials/article-comments') %>
    </article>
  </div>

  <aside class="home-sidebar divider-v">
    <%- include('../partials/ads-sidebar') %>

    <% if (related.length) { %>
      <h3 class="home-sidebar__heading">Related</h3>
      <% related.forEach(function (r) { %>
        <div class="sidebar-related-article">
          <a href="/article/<%= r.slug %>" class="sidebar-article-thumb">
            <img src="<%= thumbUrl(r.featured_image) %>"
                 onerror="this.onerror=null;this.src='/uploads/defaults/at-news-thumb.jpg'"
                 width="150" height="90" loading="lazy" alt="<%= r.title %>">
          </a>
          <div class="sidebar-related-article-info">
            <a href="/article/<%= r.slug %>"><h4><%= r.title %></h4></a>
            <% if (r.excerpt) { %><p class="sidebar-article-desc"><%= r.excerpt %></p><% } %>
            <span class="article-meta"><%= new Date(r.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %> &middot; <%= r.views_count %> views</span>
          </div>
        </div>
      <% }) %>
    <% } %>

    <% if (authorArticles.length) { %>
      <h3 class="home-sidebar__heading">More by <%= article.author_name %></h3>
      <% authorArticles.forEach(function (a) { %>
        <div class="sidebar-author-article">
          <a href="/article/<%= a.slug %>" class="sidebar-article-thumb">
            <img src="<%= thumbUrl(a.featured_image) %>"
                 onerror="this.onerror=null;this.src='/uploads/defaults/at-news-thumb.jpg'"
                 width="150" height="90" loading="lazy" alt="<%= a.title %>">
          </a>
          <div class="sidebar-author-article-info">
            <a href="/article/<%= a.slug %>"><h4><%= a.title %></h4></a>
            <% if (a.excerpt) { %><p class="sidebar-article-desc"><%= a.excerpt %></p><% } %>
            <span class="article-meta"><%= new Date(a.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %> &middot; <%= a.views_count %> views</span>
          </div>
        </div>
      <% }) %>
    <% } %>

    <% if (typeof onThisDayArticles !== 'undefined' && onThisDayArticles.length) { %>
      <h3 class="home-sidebar__heading">&#128197; On This Day <span class="otd-date"><%= new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span></h3>
      <% onThisDayArticles.forEach(function (a) { %>
        <div class="sidebar-author-article">
          <a href="/article/<%= a.slug %>" class="sidebar-article-thumb">
            <img src="<%= thumbUrl(a.featured_image) %>"
                 onerror="this.onerror=null;this.src='/uploads/defaults/at-news-thumb.jpg'"
                 width="150" height="90" loading="lazy" alt="<%= a.title %>">
          </a>
          <div class="sidebar-author-article-info">
            <a href="/article/<%= a.slug %>"><h4><%= a.title %></h4></a>
            <% if (a.excerpt) { %><p class="sidebar-article-desc"><%= a.excerpt %></p><% } %>
            <span class="article-meta"><%= a.pub_year %> &middot; <%= a.views_count %> views</span>
          </div>
        </div>
      <% }) %>
      <a href="/on-this-day" class="sidebar-more-link">See all &rarr;</a>
    <% } %>

    <% if (typeof popularTags !== 'undefined' && popularTags.length) { %>
      <h3 class="home-sidebar__heading">Popular Tags</h3>
      <div class="tag-cloud">
        <% popularTags.forEach(function (t) { %>
          <a href="/tag/<%= encodeURIComponent(t.tag) %>" class="tag-cloud-item" style="font-size: <%= Math.min(1.1, 0.75 + (t.count / 20) * 0.35) %>rem">
            <%= t.tag %> <span class="tag-cloud-count">(<%= t.count %>)</span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </aside>
</div>

<% if (!isInline) { %>
<script src="/js/<%= process.env.NODE_ENV === 'production' ? 'article.min.js?v=2' : 'article.js' %>" defer></script>
<script src="/js/<%= process.env.NODE_ENV === 'production' ? 'infinite-scroll.min.js' : 'infinite-scroll.js' %>" defer></script>
<% if (article.is_liveblog && article.liveblog_status === 'live') { %>
  <script src="/js/<%= process.env.NODE_ENV === 'production' ? 'liveblog.min.js' : 'liveblog.js' %>" defer></script>
<% } %>
<% } %>

<% } %>

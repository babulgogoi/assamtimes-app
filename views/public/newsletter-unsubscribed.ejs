<div class="static-page">
  <h1 class="page-title">Unsubscribed</h1>
  <div class="static-page__body">
    <% if (found) { %>
      <p>You've been unsubscribed from the Assam Times newsletter. Sorry to see you go.</p>
    <% } else { %>
      <p>That unsubscribe link is invalid or has already been used.</p>
    <% } %>
    <p><a href="/subscribe">Manage your subscriptions</a></p>
  </div>
</div>

<%- include('ads-sidebar') %>

<%
  function sidebarArticleRow(article) {
    %>
    <div class="sidebar-article">
      <a href="/article/<%= article.slug %>" class="sidebar-article-thumb">
        <img src="<%= thumbUrl(article.featured_image) %>"
             onerror="this.onerror=null;this.src='/uploads/defaults/at-news-thumb.jpg'"
             width="150" height="90" loading="lazy" alt="<%= article.title %>">
      </a>
      <div class="sidebar-article-info">
        <a href="/article/<%= article.slug %>"><h4><%= article.title %></h4></a>
        <% if (article.excerpt) { %><p class="sidebar-article-desc"><%= article.excerpt %></p><% } %>
        <span class="article-meta"><%= new Date(article.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %> &middot; <%= article.views_count %> views</span>
      </div>
    </div>
    <%
  }
%>

<h3 class="home-sidebar__heading">Latest News</h3>
<% latestNews.forEach(sidebarArticleRow) %>

<h3 class="home-sidebar__heading">Most Read</h3>
<% mostViewed.forEach(sidebarArticleRow) %>
